{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/"]
    },
    "assert": {
      "assertions": {
        "categories:performance":    ["warn",  { "minScore": 0.7 }],
        "categories:accessibility":  ["warn",  { "minScore": 0.8 }],
        "categories:best-practices": ["error", { "minScore": 0.8 }],
        "categories:pwa":            ["warn",  { "minScore": 0.6 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
